      "content": {
        "title": null,
        "sub": null,
        "html": "<section class=\"pp-section pp-section--sm\" style=\"padding-top: 0;\">\n      <div class=\"pp-container\">\n        <div class=\"pp-grid pp-grid--2\" style=\"gap: var(--pp-space-12); align-items: start;\">\n\n          <div>\n            <span class=\"pp-eyebrow\">Deodorizing & Disinfecting · 300 g / 500 g</span>\n            <h1 style=\"margin-bottom: var(--pp-space-2);\">Cat Litter Companion Deodorizer</h1>\n                        <p class=\"pp-lead\">Adsorbs and breaks down odor molecules</p>\n\n            <div class=\"pp-trust-row\" style=\"margin-bottom: var(--pp-space-6);\">\n              <span class=\"pp-badge pp-badge--amber\">MOQ 1,000</span>\n              <span class=\"pp-badge\">Sample on request</span>\n              <span class=\"pp-badge\">Quote in 1 business day</span>\n            </div>\n\n            \n            <div style=\"aspect-ratio: 1; background: linear-gradient(135deg, #ffffff, #f8fafc); border-radius: var(--pp-radius-xl); display: flex; align-items: center; justify-content: center; border: 1px solid var(--pp-ink-200); overflow: hidden;\">\n              <img src=\"/assets/img/products/cat-litter-companion.png?v=2\" alt=\"Cat Litter Companion Deodorizer\" style=\"width: 100%; height: 100%; object-fit: contain; padding: var(--pp-space-4);\" onerror=\"this.parentElement.innerHTML='<div style=&quot;font-size: 6rem; color: var(--pp-teal-300);&quot;>🐾</div>'\">\n            </div>\n            <p style=\"font-size: var(--pp-text-xs); color: var(--pp-ink-500); margin-top: var(--pp-space-2); text-align: center;\">DEKOBIO · 300 g / 500 g</p>\n          </div>\n\n          <div>\n                        <div class=\"pp-card\" style=\"margin-bottom: var(--pp-space-4);\">\n\n\n              <h3 data-i18n=\"products.keyFeatures\" style=\"margin-bottom: var(--pp-space-2);\">Self-designed for cat litter micro-climate</h3>\n\n\n              <ul style=\"list-style: none; padding: 0; margin: 0; font-size: var(--pp-text-sm);\">\n\n\n                <li style=\"margin-bottom: var(--pp-space-1);\"><strong style=\"color: var(--pp-teal-700);\">Built for litter-box micro-climate</strong> &#8212; powder spreads through granules and reaches odor zones under clumps.</li>\n\n                <li style=\"margin-bottom: var(--pp-space-1);\"><strong style=\"color: var(--pp-teal-700);\">Low-dust silica base</strong> &#8212; food-grade Silicon Dioxide absorbs moisture without raising dust during digging.</li>\n\n                <li style=\"margin-bottom: var(--pp-space-1);\"><strong style=\"color: var(--pp-teal-700);\">Bio-enzyme activation on contact</strong> &#8212; kicks in when urine/feces hit the powder &#8212; no daily stirring needed.</li>\n\n                <li style=\"margin-bottom: 0;\"><strong style=\"color: var(--pp-teal-700);\">Plant-extract neutralizer, not mask</strong> &#8212; breaks down mercaptans (cat urine smell) instead of covering with fragrance.</li>\n\n\n              </ul>\n\n\n            </div>\n\n\n            <div class=\"pp-card\" style=\"margin-bottom: var(--pp-space-4);\">\n\n\n              <h3 data-i18n=\"products.ingredients\" style=\"margin-bottom: var(--pp-space-2);\">Main ingredients &#8212; and what each one powers</h3>\n\n\n              <table style=\"width:100%; border-collapse: collapse; font-size: var(--pp-text-sm);\">\n\n\n                <tbody>\n\n\n                  <tr style=\" border-bottom: 1px solid var(--pp-ink-100);\">\n\n                    <td style=\"padding: 6px 6px 6px 0; font-weight: 600; color: var(--pp-teal-700); vertical-align: top; white-space: nowrap;\">Baking Soda</td>\n\n                    <td style=\"padding: 6px 0; color: var(--pp-ink-700); vertical-align: top;\">pH buffer &#8212; works under clumps.</td>\n\n                  <tr style=\" border-bottom: 1px solid var(--pp-ink-100);\">\n\n                    <td style=\"padding: 6px 6px 6px 0; font-weight: 600; color: var(--pp-teal-700); vertical-align: top; white-space: nowrap;\">Silicon Dioxide</td>\n\n                    <td style=\"padding: 6px 0; color: var(--pp-ink-700); vertical-align: top;\">Low-dust base &#8212; safe for digging.</td>\n\n                  <tr style=\" border-bottom: 1px solid var(--pp-ink-100);\">\n\n                    <td style=\"padding: 6px 6px 6px 0; font-weight: 600; color: var(--pp-teal-700); vertical-align: top; white-space: nowrap;\">Bio-enzymes</td>\n\n                    <td style=\"padding: 6px 0; color: var(--pp-ink-700); vertical-align: top;\">On-contact activation &#8212; no daily stirring.</td>\n\n                  <tr style=\"\">\n\n                    <td style=\"padding: 6px 6px 6px 0; font-weight: 600; color: var(--pp-teal-700); vertical-align: top; white-space: nowrap;\">Plant Extracts</td>\n\n                    <td style=\"padding: 6px 0; color: var(--pp-ink-700); vertical-align: top;\">Mercaptan neutralizer &#8212; no fragrance cover-up.</td>\n\n\n\n                </tbody>\n\n\n              </table>\n\n\n            </div>\n\n\n\n\n            <div class=\"pp-card\">\n\n\n              <h3 data-i18n=\"products.labReports\" style=\"margin-bottom: var(--pp-space-2);\">Third-party lab reports</h3>\n\n\n              <ul style=\"list-style: none; padding: 0; margin: 0; font-size: var(--pp-text-sm);\">\n\n\n                <li style=\"padding: 6px 0 0;\">\n\n                  <a href=\"/assets/img/certs/Cat-Litter-Deodorizer-Ammonia-Removal-Test.pdf\" download=\"Cat-Litter-Deodorizer-Ammonia-Removal-Test.pdf\" rel=\"noopener\" style=\"display: flex; align-items: center; gap: var(--pp-space-3); text-decoration: none; color: var(--pp-ink-800);\">\n\n                    <span style=\"font-size: 1.25rem; line-height: 1;\" aria-hidden=\"true\">&#128196;</span>\n\n                    <span style=\"flex: 1; min-width: 0;\">\n\n                      <span style=\"display: block; color: var(--pp-teal-700); font-weight: 600;\">Ammonia Removal &#183; 96.6%</span>\n\n                      <span style=\"font-size: var(--pp-text-xs); color: var(--pp-ink-500);\">2.1 MB &#183; PDF</span>\n\n                    </span>\n\n                    <span style=\"color: var(--pp-teal-600); font-weight: 600; white-space: nowrap;\">Download &#8595;</span>\n\n                  </a>\n\n                </li>\n\n\n              </ul>\n\n\n            </div>\n\n        </div>\n      </div>\n    </section>"
      }
