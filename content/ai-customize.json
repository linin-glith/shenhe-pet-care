    {
      "classes": "pp-section",
      "bg": "plain",
      "type": "prose",
      "content": {
        "title": null,
        "sub": null,
        "html": "<section class=\"pp-section\">\n      <div class=\"pp-container\">\n        <div class=\"pp-wizard pp-wizard--intro\" data-wizard>\n\n          <div class=\"pp-wizard__steps\">\n            <div class=\"pp-wizard__step\" data-step=\"0\">\n              <div class=\"pp-wizard__step-num\">1</div>\n              <div class=\"pp-wizard__step-label\" data-i18n=\"ai.step1\">Category</div>\n            </div>\n            <div class=\"pp-wizard__step\" data-step=\"1\">\n              <div class=\"pp-wizard__step-num\">2</div>\n              <div class=\"pp-wizard__step-label\" data-i18n=\"ai.step2\">Function</div>\n            </div>\n            <div class=\"pp-wizard__step\" data-step=\"2\">\n              <div class=\"pp-wizard__step-num\">3</div>\n              <div class=\"pp-wizard__step-label\" data-i18n=\"ai.step3\">Market</div>\n            </div>\n            <div class=\"pp-wizard__step\" data-step=\"3\">\n              <div class=\"pp-wizard__step-num\">4</div>\n              <div class=\"pp-wizard__step-label\" data-i18n=\"ai.step4\">Volume</div>\n            </div>\n          </div>\n\n          \n          <div class=\"pp-wizard__intro\" data-wizard-intro>\n            <span class=\"pp-wizard__intro-icon\">\n              <svg width=\"2\" height=\"24\" aria-hidden=\"true\"><use href=\"/assets/img/icons/sprite.svg#icon-cube/\"></svg>\n            </span>\n            <h3 data-i18n=\"ai.introTitle\">Find your perfect product match</h3>\n            <p data-i18n=\"ai.introDesc\">Answer 4 quick questions and we'll match you to the top 5 SKUs from our 20-product library — with rationale, MOQ hints, and OEM/ODM options.</p>\n            <button class=\"pp-btn pp-btn--primary pp-wizard__intro-btn\" type=\"button\" data-wizard-action=\"start\">\n              <span data-i18n=\"ai.introCta\">Start · 30 seconds</span> →\n            </button>\n          </div>\n\n          <div class=\"pp-wizard__panel\" data-wizard-step=\"0\">\n            <div class=\"pp-wizard__panel-meta\">STEP 1 OF 4</div>\n            <h3 data-i18n=\"ai.step1Title\">Which product line?</h3>\n            <p class=\"pp-wizard__panel-hint\" data-i18n=\"ai.step1Hint\">Pick the line closest to your target product.</p>\n            <div class=\"pp-wizard__options\"></div>\n          </div>\n          <div class=\"pp-wizard__panel\" data-wizard-step=\"1\">\n            <div class=\"pp-wizard__panel-meta\">STEP 2 OF 4</div>\n            <h3 data-i18n=\"ai.step2Title\">What function do you need?</h3>\n            <p class=\"pp-wizard__panel-hint\" data-i18n=\"ai.step2Hint\">Select the primary function your product should deliver.</p>\n            <div class=\"pp-wizard__options\"></div>\n          </div>\n          <div class=\"pp-wizard__panel\" data-wizard-step=\"2\">\n            <div class=\"pp-wizard__panel-meta\">STEP 3 OF 4</div>\n            <h3 data-i18n=\"ai.step3Title\">Target market?</h3>\n            <p class=\"pp-wizard__panel-hint\" data-i18n=\"ai.step3Hint\">Where will you sell? This helps us match SKUs with relevant compliance.</p>\n            <div class=\"pp-wizard__options\"></div>\n          </div>\n          <div class=\"pp-wizard__panel\" data-wizard-step=\"3\">\n            <div class=\"pp-wizard__panel-meta\">STEP 4 OF 4</div>\n            <h3 data-i18n=\"ai.step4Title\">Order volume?</h3>\n            <p class=\"pp-wizard__panel-hint\" data-i18n=\"ai.step4Hint\">Estimated volume for your first PO. We use this to recommend the right tier.</p>\n            <div class=\"pp-wizard__options\"></div>\n            <div class=\"pp-wizard__nav\">\n              <button type=\"button\" class=\"pp-btn pp-btn--ghost\" data-wizard-action=\"back\">← <span data-i18n=\"ai.back\">Back</span></button>\n              <span class=\"pp-wizard__nav-meta\">Selecting an option advances automatically</span>\n              <span></span>\n            </div>\n          </div>\n\n          <div data-wizard-results></div>\n        </div>\n      </div>\n    </section>"
      }
