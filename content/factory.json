        "html": "<section class=\"pp-section\" style=\"padding-top: 0;\">\n      <div class=\"pp-container\">\n        <figure style=\"margin: 0; border-radius: var(--pp-radius-xl); overflow: hidden; box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);\">\n          <img src=\"/assets/img/factory/factory-exterior-1344x768.png\" alt=\"SHENHE ZHONGKE industrial park aerial view — Heyuan, Guangdong\" loading=\"lazy\" style=\"width: 100%; height: auto; display: block;\">\n        </figure>\n      </div>\n    </section>"
