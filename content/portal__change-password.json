   "content": {
    "html": "<main class=\"pz-shell pz-shell--narrow pz-section\">\n    <span class=\"pz-eyebrow\">Customer portal</span>\n    <h1>Change your password</h1>\n    <p class=\"pz-lead\">\n      <span id=\"cp-welcome\"></span>\n      For security, please set a new password before continuing. Your temporary password was emailed to you.\n    </p>\n\n    <form id=\"change-pw-form\" class=\"pz-card\" novalidate>\n      <div id=\"form-msg\"></div>\n      <div class=\"pz-form__field\">\n        <label class=\"pz-form__label\" for=\"current\">Current password</label>\n        <input class=\"pz-form__input\" type=\"password\" id=\"current\" name=\"current_password\" required minlength=\"8\" autocomplete=\"current-password\">\n      </div>\n      <div class=\"pz-form__field\">\n        <label class=\"pz-form__label\" for=\"new\">New password</label>\n        <input class=\"pz-form__input\" type=\"password\" id=\"new\" name=\"new_password\" required minlength=\"8\" autocomplete=\"new-password\">\n        <div class=\"pz-form__hint\">At least 8 characters. Avoid reusing your temporary password.</div>\n      </div>\n      <div class=\"pz-form__field\">\n        <label class=\"pz-form__label\" for=\"confirm\">Confirm new password</label>\n        <input class=\"pz-form__input\" type=\"password\" id=\"confirm\" name=\"confirm_password\" required minlength=\"8\" autocomplete=\"new-password\">\n      </div>\n      <button class=\"pz-btn pz-btn--primary pz-btn--lg pz-btn--block\" type=\"submit\">Change password & continue</button>\n      <p style=\"margin-top:14px; font-size:13px; color:var(--pp-ink-500); text-align:center;\">\n        Forgot your temp password? Use the <a href=\"/contact.html\">contact form</a> to request a new one.\n      </p>\n    </form>\n  </main>"
   }
  }
 ],
