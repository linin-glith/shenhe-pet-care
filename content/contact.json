      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "name": "Contact &amp; Enquiry FAQ",
        "url": "https://shenhezhongke.com/contact.html",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How quickly do you respond to enquiries?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Standard response time is within one business day during China business hours (09:00-18:00 CST, Mon-Sat). Urgent enquiries flagged in the subject line are answered first. Quote requests with full specification (volume, formulation, packaging) get a written quotation within one business day."
            }
          },
          {
            "@type": "Question",
            "name": "What is the sample policy?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "20 ready SKUs: samples are chargeable and the fee is confirmed in the quotation, buyer pays shipping (USD 30-80 via DHL/FedEx, 3-5 days worldwide). Custom formula samples: USD 200-500 non-refundable once lab work begins, refundable against first PO. Sample lead time: 3 days for stock, 7-10 days for custom."
            }
          },
          {
            "@type": "Question",
            "name": "What payment terms do you accept?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "35% T/T deposit + 65% balance before shipment for orders under USD 30,000. L/C at sight for orders at or above USD 30,000. USD, EUR, and RMB invoices available. PayPal accepted for sample fees only. Wire fees are borne by the ordering party."
            }
          },
          {
            "@type": "Question",
            "name": "What is your minimum order quantity?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Trial order MOQ is 1,000 sets for the bundled sets, which is a sample run and not a commercial order. The price falls as the run gets larger, and each run is quoted for the quantity and the packing you ask for. A commercial trial order below the standard minimum is a conversation, not a price list. Custom OEM MOQ starts at 1,000 bottles for liquid products, 3,000 packs for solid/powder products."
            }
          },
          {
            "@type": "Question",
            "name": "Which Incoterms do you support?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Default FOB Guangzhou/Shenzhen per ICC Publication 723E (Incoterms 2020). We also handle EXW, FCA, CIF, CFR, DAP, DDP, and DPU on request. DDP quotes are provided with a separate freight + duty estimate; final duty amount is the buyer's responsibility to confirm with their customs broker."
            }
          },
          {
            "@type": "Question",
            "name": "Can I speak with a sales manager directly?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Email sales@shenhezhongke.com or call +86-762-3909998 (English, Spanish, German spoken) during 09:00-18:00 CST. For WhatsApp enquiries, message +86 172 6665 9928. For urgent matters outside business hours, email is monitored 24/7 and answered within one business day."
            }
          }
        ]
      }
    ],
    "hasGtm": true
  },
