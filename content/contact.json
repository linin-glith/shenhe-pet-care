      "classes": "pp-section",
      "bg": "plain",
      "type": "prose",
      "content": {
        "title": "Send us a message",
        "sub": null,
        "html": "<section class=\"pp-section\">\n      <div class=\"pp-container\">\n        <div class=\"pp-grid pp-grid--2 pp-grid-align-start\" >\n\n          \n          <div>\n            <h2>Send us a message</h2>\n            <p style=\"color: var(--pp-ink-600); margin-top: var(--pp-space-2);\">Tell us your target market, MOQ, and timeline. We reply within one business day with a quote and a sample plan.</p>\n            \n      <a class=\"pp-wa-cta\" href=\"https://wa.me/8617266659928?text=Hi%2C%20I%27d%20like%20to%20discuss%20a%20pet%20wash%20%26%20care%20OEM%2FODM%20project\" target=\"_blank\" rel=\"noopener\" data-i18n=\"contact.waCta\">\n        <svg class=\"pp-wa-cta__icon\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\">\n          <path fill=\"currentColor\" d=\"M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.1-.3.2-.4.1-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2.1 3.2 5 4.4.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z\"/>\n          <path fill=\"currentColor\" d=\"M12 2C6.5 2 2 6.5 2 12c0 1.7.4 3.4 1.3 4.9L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3c-.9-1.4-1.3-2.9-1.3-4.5 0-4.6 3.7-8.3 8.3-8.3s8.3 3.7 8.3 8.3-3.7 8.4-8.2 8.4z\"/>\n        </svg>\n        <span class=\"pp-wa-cta__text\">\n          <strong data-i18n=\"contact.waCtaTitle\">Prefer WhatsApp? Chat in 1 click</strong>\n          <small data-i18n=\"contact.waCtaSub\">A human replies within one business day during business hours (CST)</small>\n        </span>\n        <span class=\"pp-wa-cta__arrow\" aria-hidden=\"true\">→</span>\n      </a>\n\n      <form class=\"pp-form\" id=\"contact-form\"\n                  action=\"javascript:void(0)\"\n                  method=\"POST\"\n                  novalidate>\n              \n              <input type=\"text\" name=\"_honey\" style=\"display:none\" tabindex=\"-1\" autocomplete=\"off\">\n              <div class=\"pp-form__row\">\n                <div class=\"pp-form__field\">\n                  <label class=\"pp-form__label\" for=\"cf-name\"><span data-i18n=\"contact.name\">Your name</span><span class=\"pp-form__req\">*</span></label>\n                  <input class=\"pp-form__input\" type=\"text\" id=\"cf-name\" name=\"name\" required autocomplete=\"name\">\n                </div>\n                <div class=\"pp-form__field\">\n                  <label class=\"pp-form__label\" for=\"cf-company\"><span data-i18n=\"contact.company\">Company</span></label>\n                  <input class=\"pp-form__input\" type=\"text\" id=\"cf-company\" name=\"company\" autocomplete=\"organization\">\n                </div>\n              </div>\n              <div class=\"pp-form__row\">\n                <div class=\"pp-form__field\">\n                  <label class=\"pp-form__label\" for=\"cf-email\"><span data-i18n=\"contact.email\">Email</span><span class=\"pp-form__req\">*</span></label>\n                  <input class=\"pp-form__input\" type=\"email\" id=\"cf-email\" name=\"email\" required autocomplete=\"email\">\n                </div>\n                <div class=\"pp-form__field\">\n                  <label class=\"pp-form__label\" for=\"cf-phone\"><span data-i18n=\"contact.phone\">Phone</span></label>\n                  <input class=\"pp-form__input\" type=\"tel\" id=\"cf-phone\" name=\"phone\" autocomplete=\"tel\">\n                </div>\n              </div>\n              <div class=\"pp-form__field\">\n                <label class=\"pp-form__label\" for=\"cf-country\"><span data-i18n=\"contact.country\">Country / Region</span></label>\n                <input class=\"pp-form__input\" type=\"text\" id=\"cf-country\" name=\"country\" autocomplete=\"country-name\">\n              </div>\n              <div class=\"pp-form__field\">\n                <label class=\"pp-form__label\" for=\"cf-interest\"><span data-i18n=\"contact.interest\">What are you interested in?</span></label>\n                <select class=\"pp-form__select\" id=\"cf-interest\" name=\"interest\">\n                  <option value=\"\">— Select —</option>\n                  <option value=\"oem\">OEM (custom formula)</option>\n                  <option value=\"odm\">ODM (ready formula + my label)</option>\n                  <option value=\"obm\">OBM (turnkey)</option>\n                  <option value=\"distribute\">Distribution / Wholesale</option>\n                  <option value=\"other\">Other</option>\n                </select>\n              </div>\n              <div class=\"pp-form__field\">\n                <label class=\"pp-form__label\" for=\"cf-message\"><span data-i18n=\"contact.message\">Your message</span><span class=\"pp-form__req\">*</span></label>\n                <textarea class=\"pp-form__textarea\" id=\"cf-message\" name=\"message\" required placeholder=\"Target market, MOQ, timeline, anything specific...\"></textarea>\n              </div>\n              <label class=\"pp-form__checkbox\">\n                <input type=\"checkbox\" name=\"optin\" value=\"1\">\n                <span>Send me product updates and OEM/ODM insights (optional)</span>\n              </label>\n              \n              <div class=\"pp-honeypot\" aria-hidden=\"true\">\n                <label>Leave this empty<input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label>\n              </div>\n              \n      <div class=\"pp-form__reassurance\" aria-label=\"What happens after you submit\">\n        <h3 class=\"pp-form__reassurance-title\" data-i18n=\"contact.nextTitle\">What happens next</h3>\n        <ul class=\"pp-form__reassurance-list\">\n          <li><span class=\"pp-check\" aria-hidden=\"true\">✓</span><span data-i18n=\"contact.next1\">A named sales manager reads your inquiry within one business day</span></li>\n          <li><span class=\"pp-check\" aria-hidden=\"true\">✓</span><span data-i18n=\"contact.next2\">Free initial consultation — no obligation, no spam</span></li>\n          <li><span class=\"pp-check\" aria-hidden=\"true\">✓</span><span data-i18n=\"contact.next3\">NDA available on request for sensitive formulations</span></li>\n          <li><span class=\"pp-check\" aria-hidden=\"true\">✓</span><span data-i18n=\"contact.next4\">Factory video call available before you commit</span></li>\n          <li><span class=\"pp-check\" aria-hidden=\"true\">✓</span><span data-i18n=\"contact.next5\">Custom quote tailored to your SKU, volume, packaging, destination</span></li>\n        </ul>\n      </div>\n\n      <button type=\"submit\" class=\"pp-btn pp-btn--primary pp-btn--lg pp-btn--block\" data-i18n=\"contact.send\">Send inquiry</button>\n              <div id=\"cf-success\" hidden></div>\n            </form>\n\n            </div>\n\n          \n          <div>\n            <h2 data-i18n=\"contact.info\">Direct contact</h2>\n            <div style=\"display: flex; flex-direction: column; gap: var(--pp-space-4);\">\n              <div class=\"pp-card\">\n                <strong  class=\"pp-stack-2\" data-i18n=\"footer.tel\">Tel</strong>\n                <a href=\"tel:+867623909998\">+86-762-3909998</a>\n                <div style=\"font-size: var(--pp-text-sm); color: var(--pp-ink-500); margin-top: 4px;\">Mobile: <a href=\"tel:+86 172 6665 9928\">+86 172 6665 9928</a></div>\n              </div>\n              <div class=\"pp-card\">\n                <strong  class=\"pp-stack-2\" data-i18n=\"footer.email\">Email</strong>\n                <a href=\"mailto:sales@shenhezhongke.com\">sales@shenhezhongke.com</a>\n              </div>\n              <div class=\"pp-card\">\n                <strong  class=\"pp-stack-2\">Address</strong>\n                <span data-i18n=\"footer.address\">No.141-1 Longteng Road, Gaopugang, Yuancheng District, Heyuan, Guangdong, China</span>\n              </div>\n              <div class=\"pp-card\">\n                <strong  class=\"pp-stack-2\">Working hours</strong>\n                Mon – Fri · 9:00 – 18:00 (GMT+8)\n              </div>\n            </div>\n\n            <div class=\"pp-cta-card pp-mt-6\" >\n              <span class=\"pp-cta-card__eyebrow\" data-i18n=\"cta.title\">Request a quotation within 1 business day</span>\n              <h3>Skip the form? Just send a one-liner to our sales email.</h3>\n              <p>Tell us the SKU, MOQ, and target market. We reply within one business day with a quote.</p>\n              <a class=\"pp-btn pp-btn--lg\" href=\"mailto:sales@shenhezhongke.com?subject=RFQ%20-%20SHENHE%20ZHONGKE\">Email Sales</a>\n              <p style=\"margin-top:18px; font-size:14px; color:var(--pp-ink-700);\"><strong>Already submitted?</strong></p>\n              <a class=\"pp-btn pp-btn--ghost\" href=\"/portal/login.html\">Track your inquiry progress →</a>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>"
      }
    },
    {
