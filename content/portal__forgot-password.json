   "content": {
    "html": "<main class=\"pz-shell pz-shell--narrow pz-section\">\n    <a href=\"/portal/login.html\" class=\"pz-fp-back\">← Back to sign in</a>\n    <span class=\"pz-eyebrow\">Customer portal</span>\n    <h1>Forgot your password?</h1>\n    <p class=\"pz-lead\">Enter the email you used to sign up. We'll send you a reset link.</p>\n\n    <div id=\"content\">\n      <form id=\"forgot-form\" class=\"pz-card pz-fp-card\" novalidate>\n        <div id=\"form-msg\"></div>\n        <div class=\"pz-form__field\">\n          <label class=\"pz-form__label\" for=\"email\">Your email <span class=\"req\">*</span></label>\n          <input class=\"pz-form__input\" type=\"email\" id=\"email\" name=\"email\" required autocomplete=\"email\" placeholder=\"you@company.com\">\n        </div>\n        <button class=\"pz-btn pz-btn--primary pz-btn--lg pz-btn--block\" type=\"submit\" id=\"submit-btn\">Send reset link</button>\n        <p style=\"margin-top:14px; font-size:13px; color:var(--pp-ink-500); text-align:center;\">\n          Remembered it? <a href=\"/portal/login.html\">Sign in →</a>\n        </p>\n      </form>\n    </div>\n  </main>"
   }
